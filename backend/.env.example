# Entorno: development | test | production
APP_ENV=development

# Obligatoria en production. En development/test tiene un valor por defecto de uso local.
SECRET_KEY=change-me

# Cadena de conexión a Postgres. Obligatoria en production.
DATABASE_URL=postgresql+psycopg://nureon:nureon@localhost:5433/nureon_dev

# Solo la usa la suite de tests; si falta, cae a DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://nureon:nureon@localhost:5433/nureon_test

# Orígenes permitidos para CORS, separados por coma. Obligatoria en production.
CORS_ALLOWED_ORIGINS=http://localhost:4200

LOG_LEVEL=INFO

# Proveedor de identidad: local | cognito. En development y test, local por defecto.
# `local` es un doble en memoria para tests y desarrollo: con APP_ENV=production la app no arranca.
IDENTITY_PROVIDER=local

# Sólo con IDENTITY_PROVIDER=cognito (obligatorias ahí, y en production).
# El user pool todavía no existe: ver docs/backend-status.md.
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Perfil del AWS CLI que usa boto3, fijado explícitamente. Obligatorio con IDENTITY_PROVIDER=cognito
# fuera de production. `default` se rechaza: en las máquinas de desarrollo tiene acceso completo a la
# cuenta. En production no se usa perfil: las credenciales salen del rol de la plataforma.
# Las claves nunca van en este archivo.
AWS_PROFILE=nureon

# Clasificador que calcula el resultado al cerrar un intento: stub | legacy_tree | trained.
# stub: conteo por grupo, determinístico, no es ML (por defecto en development y test).
# legacy_tree: el árbol de decisión de 2024. trained: los doce Random Forest de los cortes (cuatro por
# corte); si algún modelo falta o no coincide con el manifest, no arranca.
# En production es obligatoria: no tiene valor por defecto.
CLASSIFIER_BACKEND=stub
# Carpeta de los artefactos del entrenamiento: manifest.json y precision_by_items.json (el plan de
# cortes 40/90/145, que usan todos los clasificadores, también el stub) y cut_040/, cut_090/, cut_145/
# (los modelos de trained). Sin valor, app/ml/artifacts/. Sin plan de cortes la app no arranca.
# Para desarrollo: python scripts/make_dev_artifacts.py --out <carpeta> (artefactos sintéticos; en
# production la app no arranca con ellos).
CLASSIFIER_ARTIFACTS_DIR=

# Versión vigente de la Política de privacidad y los Términos y condiciones (Feature 11). El registro
# la guarda en users.consent_version junto con la fecha; el cliente no la elige. Es la misma que
# LEGAL_TEXT_VERSION en frontend/nureon/src/app/legal/legal-content.ts. Hasta 32 caracteres.
# En production es obligatoria; en development, sin valor se guarda "local" (los tests, siempre "local").
CONSENT_VERSION=2026-10-20

# Envío del formulario de contacto: local | ses. En development y test, local por defecto.
# `local` es un doble en memoria: no manda nada. Con APP_ENV=production la app no arranca con local.
# Con ses usa AWS_PROFILE igual que Cognito (obligatorio fuera de production; `default` se rechaza).
MAIL_SENDER=local
SES_REGION=us-east-2
# Casilla que recibe los mensajes. Obligatoria con ses. El mensaje no se guarda en ningún lado.
CONTACT_MAIL_TO=
# Remitente. Sin valor, la misma casilla de destino. En el sandbox de SES tiene que estar verificado.
CONTACT_MAIL_FROM=
# Mensajes de contacto por dirección de origen y por ventana (segundos). Sin valor, 5 por hora.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=3600
