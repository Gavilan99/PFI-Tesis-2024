# Entorno: development | test | production
APP_ENV=development

# Obligatoria en production. En development/test tiene un valor por defecto de uso local.
SECRET_KEY=change-me

# Cadena de conexión a Postgres. Obligatoria en production.
DATABASE_URL=postgresql+psycopg://nureon:nureon@localhost:5433/nureon_dev

# Solo la usa la suite de tests; si falta, cae a DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://nureon:nureon@localhost:5433/nureon_test

# Orígenes permitidos para CORS, separados por coma. Obligatoria en production.
CORS_ALLOWED_ORIGINS=http://localhost:4200

LOG_LEVEL=INFO

# Proveedor de identidad: local | cognito. En development y test, local por defecto.
# `local` es un doble en memoria para tests y desarrollo: con APP_ENV=production la app no arranca.
IDENTITY_PROVIDER=local

# Sólo con IDENTITY_PROVIDER=cognito (obligatorias ahí, y en production).
# El user pool todavía no existe: ver docs/backend-status.md.
COGNITO_REGION=sa-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Perfil del AWS CLI que usa boto3, fijado explícitamente. Obligatorio con IDENTITY_PROVIDER=cognito
# fuera de production. `default` se rechaza: en las máquinas de desarrollo tiene acceso completo a la
# cuenta. En production no se usa perfil: las credenciales salen del rol de la plataforma.
# Las claves nunca van en este archivo.
AWS_PROFILE=nureon
