# Entorno: development | test | production
APP_ENV=development

# Obligatoria en production. En development/test tiene un valor por defecto de uso local.
SECRET_KEY=change-me

# Cadena de conexión a Postgres. Obligatoria en production.
DATABASE_URL=postgresql+psycopg://nureon:nureon@localhost:5433/nureon_dev

# Solo la usa la suite de tests; si falta, cae a DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://nureon:nureon@localhost:5433/nureon_test

# Orígenes permitidos para CORS, separados por coma. Obligatoria en production.
CORS_ALLOWED_ORIGINS=http://localhost:4200

LOG_LEVEL=INFO
